#include <windows.h>
#include "brain-control-resource.h"

IDI_BRAIN_CONTROL ICON "brain-control.ico"

IDD_BRAIN_CONTROL DIALOG 0, 0, 240, 160
STYLE WS_POPUP
FONT 8, "Tahoma"
BEGIN
    LISTBOX IDC_SECTIONS, 0, 0, 60, 160, LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 128, 140, 50, 16, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 184, 140, 50, 16, WS_TABSTOP
END

IDD_PAGE_DISPLAY DIALOG 0, 0, 150, 106
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    LTEXT "Main screen brightness", -1, 0, 0, 150, 10
    CONTROL "", IDC_MAIN_BRIGHTNESS, "msctls_trackbar32", 0x0001 | WS_TABSTOP, 0, 12, 150, 18
    LTEXT "Sub screen brightness", IDC_SUB_LABEL, 0, 36, 150, 10
    CONTROL "", IDC_SUB_BRIGHTNESS, "msctls_trackbar32", 0x0001 | WS_TABSTOP, 0, 48, 150, 18
    LTEXT "Dim level when idle", IDC_DIM_LABEL, 0, 72, 150, 10
    CONTROL "", IDC_DIM_LEVEL, "msctls_trackbar32", 0x0001 | WS_TABSTOP, 0, 84, 150, 18
END

IDD_PAGE_ROTATION DIALOG 0, 0, 150, 84
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    AUTORADIOBUTTON "Landscape (0)", IDC_ROTATION_0, 0, 0, 72, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Portrait (90)", IDC_ROTATION_90, 76, 0, 74, 12
    AUTORADIOBUTTON "Landscape (180)", IDC_ROTATION_180, 0, 14, 72, 12
    AUTORADIOBUTTON "Portrait (270)", IDC_ROTATION_270, 76, 14, 74, 12
    AUTOCHECKBOX "Use this orientation at startup", IDC_STARTUP, 0, 32, 150, 12, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX "Rotate when folded into tablet mode", IDC_AUTO_ROTATE, 0, 50, 150, 12, WS_GROUP | WS_TABSTOP
    LTEXT "Tablet orientation:", IDC_TABLET_LABEL, 0, 68, 70, 10
    COMBOBOX IDC_TABLET_ROTATION, 72, 66, 78, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_PAGE_NIGHT_LIGHT DIALOG 0, 0, 150, 106
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    AUTOCHECKBOX "Warm the screen at night", IDC_NIGHT_ENABLED, 0, 0, 150, 12, WS_TABSTOP
    LTEXT "From:", -1, 0, 20, 44, 10
    CONTROL "", IDC_NIGHT_START, "SysDateTimePick32", 0x0009 | WS_TABSTOP, 46, 17, 84, 14
    LTEXT "To:", -1, 0, 38, 44, 10
    CONTROL "", IDC_NIGHT_END, "SysDateTimePick32", 0x0009 | WS_TABSTOP, 46, 35, 84, 14
    LTEXT "Fade over:", -1, 0, 58, 44, 10
    COMBOBOX IDC_NIGHT_TRANSITION, 46, 55, 84, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Warmth:", -1, 0, 78, 44, 10
    CONTROL "", IDC_NIGHT_STRENGTH, "msctls_trackbar32", 0x0001 | WS_TABSTOP, 46, 74, 104, 18
    LTEXT "Previewing", IDC_NIGHT_PREVIEWING, 46, 94, 104, 10
END

IDD_PAGE_TOUCHPAD DIALOG 0, 0, 150, 70
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    AUTOCHECKBOX "Use the touch panel as a touchpad", IDC_PAD_ENABLED, 0, 0, 150, 12, WS_TABSTOP
    LTEXT "Speed:", -1, 0, 20, 34, 10
    CONTROL "", IDC_PAD_SPEED, "msctls_trackbar32", 0x0001 | WS_TABSTOP, 36, 16, 114, 18
    AUTOCHECKBOX "Faster for quick strokes", IDC_PAD_ACCELERATION, 0, 40, 150, 12, WS_TABSTOP
    AUTOCHECKBOX "Tap to click", IDC_PAD_TAP_TO_CLICK, 0, 56, 150, 12, WS_TABSTOP
END

IDD_PAGE_SOUND DIALOG 0, 0, 150, 66
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    LTEXT "Volume", -1, 0, 0, 150, 10
    CONTROL "", IDC_VOLUME, "msctls_trackbar32", 0x0001 | WS_TABSTOP, 0, 12, 150, 18
    AUTOCHECKBOX "Key clicks", IDC_KEY_CLICKS, 0, 36, 150, 12, WS_TABSTOP
    AUTOCHECKBOX "Screen taps", IDC_SCREEN_TAPS, 0, 52, 150, 12, WS_TABSTOP
END

IDD_PAGE_POWER DIALOG 0, 0, 150, 120
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    LTEXT "", IDC_BATTERY_STATUS, 0, 0, 150, 20
    LTEXT "Idle for", -1, 0, 24, 46, 10
    LTEXT "Battery", -1, 48, 24, 50, 10
    LTEXT "Plugged in", -1, 100, 24, 50, 10
    LTEXT "Dim", -1, 0, 38, 46, 10
    COMBOBOX IDC_BATTERY_DIM, 48, 36, 50, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_AC_DIM, 100, 36, 50, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Screen off", -1, 0, 54, 46, 10
    COMBOBOX IDC_BATTERY_OFF, 48, 52, 50, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_AC_OFF, 100, 52, 50, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Sleep", -1, 0, 70, 46, 10
    COMBOBOX IDC_BATTERY_SLEEP, 48, 68, 50, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_AC_SLEEP, 100, 68, 50, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Battery type", IDC_BATTERY_LABEL, 0, 90, 50, 10
    COMBOBOX IDC_BATTERY_TYPE, 52, 88, 98, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Sets the levels for the battery gauge and warnings.", IDC_BATTERY_NOTE, 0, 104, 150, 16
END

IDD_PAGE_CPU DIALOG 0, 0, 150, 96
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    AUTORADIOBUTTON "Follow load (240 to 454 MHz)", IDC_CPU_DYNAMIC, 0, 0, 150, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Always 454 MHz", IDC_CPU_FAST, 0, 14, 150, 12
    AUTORADIOBUTTON "Sharp's 240 MHz", IDC_CPU_SHARP, 0, 28, 150, 12
    LTEXT "", IDC_CPU_STATUS, 0, 48, 150, 30
END

IDD_PAGE_DEBUG DIALOG 0, 0, 150, 110
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    AUTOCHECKBOX "Start Debug Agent at boot", IDC_DEBUG_AT_BOOT, 0, 0, 150, 12, WS_TABSTOP
    LTEXT "", IDC_DEBUG_STATUS, 0, 18, 150, 30
    PUSHBUTTON "Start now", IDC_DEBUG_START, 0, 52, 60, 16, WS_TABSTOP
    PUSHBUTTON "Stop now", IDC_DEBUG_STOP, 66, 52, 60, 16, WS_TABSTOP
    LTEXT "Lets a computer on USB copy files and run programs with ce-debug. Anyone with a USB cable can do the same while it runs.", IDC_DEBUG_NOTE, 0, 76, 150, 32
END

IDD_PAGE_ABOUT DIALOG 0, 0, 150, 120
STYLE WS_CHILD
FONT 8, "Tahoma"
BEGIN
    EDITTEXT IDC_ABOUT_TEXT, 0, 0, 150, 120, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
END
